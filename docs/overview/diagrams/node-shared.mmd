---
config:
  theme: base
  htmlLabels: false
  flowchart:
    htmlLabels: false
    useMaxWidth: false
    curve: basis
    nodeSpacing: 40
    rankSpacing: 55
    padding: 14
  themeVariables:
    fontFamily: "Inter, Segoe UI, Helvetica Neue, Arial, sans-serif"
    fontSize: 15px
    primaryColor: "#ffffff"
    primaryBorderColor: "#94a3b8"
    primaryTextColor: "#1e293b"
    lineColor: "#64748b"
    clusterBkg: "#f8fafc"
    clusterBorder: "#cbd5e1"
    edgeLabelBackground: "#ffffff"
    titleColor: "#334155"
---
flowchart LR
    subgraph DISKS["Block devices"]
        direction TB
        VDA[("`**vda** 80 GB
root disk`")]
        VDB[("`**vdb** 780 GB
CEPH volume`")]
        VDC[("`**vdc** 780 GB
CEPH volume`")]
        NV0[("`**nvme0n1** 3.5 TB
local NVMe, ephemeral`")]
        NV1[("`**nvme1n1** 3.5 TB
local NVMe, ephemeral`")]
    end

    subgraph LOCAL["Node-local"]
        direction TB
        ROOT("`**/** ext4
OS + packages only`")
        LV("`**LVM** scratch_vg/scratch
1.52 TB`")
        SCRATCH("`**/scratch** ext4, mode 1777
node-local temp data`")
    end

    subgraph MOOSE["MooseFS"]
        direction TB
        C1("/mnt/mfschunks/chunk1 · xfs")
        C2("/mnt/mfschunks/chunk2 · xfs")
        CS("`**moosefs-chunkserver**`")
        MFS[("`**MooseFS namespace**
2 copies across hpc01-03`")]
        MNT("`**/mnt/mfs**
FUSE mount`")
    end

    subgraph MOUNTS["Bind mounts"]
        direction TB
        HOME("`**/home**`")
        OPT("`**/opt**`")
        SRV("`**/srv**
hpc01 only`")
        DOCK("`**/var/lib/docker**
hpc01 only`")
    end

    VDA --> ROOT
    VDB --> LV
    VDC --> LV
    LV --> SCRATCH
    NV0 --> C1 --> CS
    NV1 --> C2 --> CS
    CS <--> MFS
    MFS --> MNT
    MNT --> HOME & OPT & SRV & DOCK

    classDef shared fill:#e0ecfb,stroke:#2f6fbf,stroke-width:1.5px,color:#0f2a4d
    classDef group fill:#e3f4e8,stroke:#2e8b57,stroke-width:1.5px,color:#123d25
    classDef store fill:#fff1d6,stroke:#c47f12,stroke-width:1.5px,color:#4a2f05
    classDef svc fill:#efe6fa,stroke:#7b4fb3,stroke-width:1.5px,color:#2e1650
    classDef edge fill:#f1f5f9,stroke:#64748b,stroke-width:1.5px,color:#1e293b
    classDef mount fill:#ffffff,stroke:#94a3b8,stroke-width:1px,color:#1e293b
    classDef idle fill:#f8fafc,stroke:#cbd5e1,stroke-width:1px,stroke-dasharray:4 3,color:#64748b
    class VDA,VDB,VDC,NV0,NV1 store
    class ROOT,LV,SCRATCH mount
    class C1,C2,CS,MNT shared
    class MFS shared
    class HOME,OPT,SRV,DOCK mount
    style DISKS fill:#fffaf0,stroke:#e8c27a
    style LOCAL fill:#f8fafc,stroke:#cbd5e1
    style MOOSE fill:#f2f7fe,stroke:#9dbde6
    style MOUNTS fill:#f8fafc,stroke:#cbd5e1
