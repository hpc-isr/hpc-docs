---
config:
  theme: base
  htmlLabels: false
  flowchart:
    htmlLabels: false
    useMaxWidth: false
    curve: basis
    nodeSpacing: 40
    rankSpacing: 55
    padding: 14
  themeVariables:
    fontFamily: "Inter, Segoe UI, Helvetica Neue, Arial, sans-serif"
    fontSize: 15px
    primaryColor: "#ffffff"
    primaryBorderColor: "#94a3b8"
    primaryTextColor: "#1e293b"
    lineColor: "#64748b"
    clusterBkg: "#f8fafc"
    clusterBorder: "#cbd5e1"
    edgeLabelBackground: "#ffffff"
    titleColor: "#334155"
---
flowchart TB
    U(["`**Users and admins**
campus · IST VPN · Internet`"])

    subgraph PUBLIC["Entry points · *.isr.tecnico.ulisboa.pt"]
        direction LR
        WEB("`**HTTPS :443**
sso.isr · traefik.hpc`")
        SSHIN("`**SSH :22**
firewalld + fail2ban on every node`")
    end

    subgraph VPS["IST VPS platform · private subnet 100.68.8.64/27"]
        direction LR
        subgraph SHARED["Shared SLURM cluster"]
            direction TB
            H1("`**hpc01** · 100.68.8.86
slurmctld + slurmd
MooseFS master + chunkserver
Traefik · Authentik
LDAP outpost :636 for all nodes`")
            H2("`**hpc02** · 100.68.8.70
slurmd
MooseFS chunkserver + metalogger`")
            H3("`**hpc03** · 100.68.8.76
slurmd
MooseFS chunkserver + metalogger`")
        end
        subgraph GROUPS["Group nodes · one per research group"]
            direction TB
            GN("`**hpc-dsor** · 100.68.8.71
**hpc-irsg** · 100.68.8.73
**hpc-laseeb** · 100.68.8.75
**hpc-vislab** · 100.68.8.84
**hpc-sipg** · 100.68.8.91`")
            GC("`**Common to every group node**
own /home and services
no SLURM · no MooseFS
logins via LDAPS to hpc01
firewalld + fail2ban`")
        end
    end

    subgraph OUTSIDE["Outside the VMs"]
        direction LR
        CEPH[("`**CEPH block storage**
2 × ~750 GB per VM`")]
    end

    U --> WEB & SSHIN
    SSHIN -->|"users: hpc01 only"| H1
    SSHIN -->|"own group only"| GROUPS
    WEB -->|"Traefik"| H1
    H1 <-->|"MooseFS · SLURM · srun"| H2
    H1 <--> H3
    H3 -.->|"block volumes"| CEPH
    GN -.-> CEPH
    GN --- GC

    classDef shared fill:#e0ecfb,stroke:#2f6fbf,stroke-width:1.5px,color:#0f2a4d
    classDef group fill:#e3f4e8,stroke:#2e8b57,stroke-width:1.5px,color:#123d25
    classDef store fill:#fff1d6,stroke:#c47f12,stroke-width:1.5px,color:#4a2f05
    classDef svc fill:#efe6fa,stroke:#7b4fb3,stroke-width:1.5px,color:#2e1650
    classDef edge fill:#f1f5f9,stroke:#64748b,stroke-width:1.5px,color:#1e293b
    classDef mount fill:#ffffff,stroke:#94a3b8,stroke-width:1px,color:#1e293b
    classDef idle fill:#f8fafc,stroke:#cbd5e1,stroke-width:1px,stroke-dasharray:4 3,color:#64748b
    class U,SSHIN,WEB edge
    class H1,H2,H3 shared
    class GN group
    class GC mount
    class CEPH store
    style PUBLIC fill:#f8fafc,stroke:#cbd5e1
    style VPS fill:#fbfcfe,stroke:#94a3b8,stroke-dasharray:6 4
    style SHARED fill:#f2f7fe,stroke:#9dbde6
    style OUTSIDE fill:#fffaf0,stroke:#e8c27a
    style GROUPS fill:#f2faf4,stroke:#9fd0b1
